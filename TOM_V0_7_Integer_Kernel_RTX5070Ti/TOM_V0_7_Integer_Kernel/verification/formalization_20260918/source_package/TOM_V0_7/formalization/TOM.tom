ATTRIBUTION_IS_METADATA
NO_ACRONYM_EXPANSION

# Human-readable declaration, NOT executable machine instructions.
# Angle brackets bind roles; they do not place objects on a graph.

SDF T
SDF J<T>
SDF phi
SDF InvLog<phi>
SDF C<J<T>>
SDF E<C<J<T>> ; InvLog<phi>>
SDF Arch<C<J<T>> ; E<C<J<T>> ; InvLog<phi>>>
SDF InverseOccam<Arch<C<J<T>> ; E<C<J<T>> ; InvLog<phi>>>>

TOM := InverseOccam<Arch<C<J<T>> ; E<C<J<T>> ; InvLog<phi>>>>
QUALIFIED_BY FORWARD_T_PRECEDENCE

T_PRECEDENCE := NO_ANTICIPATION
               PRESERVE_COMPLETED_COMMITMENTS
               STRUCTURAL_INVERSE_IS_NOT_TIME_REVERSE
               SELF_CONTINUATION_IS_LATER_QUALIFIED
               DESCRIPTION_COMPRESSION_DOES_NOT_ERASE_ELAPSED_DURATION

INVERSE_OCCAM := EQUAL_SELECTED_READINGS_DO_NOT_ERASE_DEFINING_DISTINCTIONS

NO_REQUIRED_QUATERNION_ARENA
NO_REQUIRED_COORDINATE_GRID
NO_REQUIRED_EXTERNAL_METRIC
NO_REQUIRED_OPERATOR_GRAPH
NO_REQUIRED_CARDINALITY_OBSERVABLE
NO_COMPULSORY_PSI_ENVELOPE
NO_FIXED_INTRINSIC_NESTING_DEPTH

SCALAR_AUDIT_IS_EXTERNAL
PHYSICAL_INTERPRETATION_REQUIRES_ITS_OWN_LAW_AND_EVIDENCE
FINITE_AUDIT_PROGRAM_IS_NOT_INTRINSIC_TOM
